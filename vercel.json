{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mohamed-osman-portfolio.vercel.app" }],
      "destination": "https://mohamed-osman.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.mohamed-osman.com" }],
      "destination": "https://mohamed-osman.com/:path*",
      "permanent": true
    }
  ]
}
